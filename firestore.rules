rules\_version = '2'; 
service cloud.firestore { 
 match /databases/{database}/documents { 
  match /tenants/{tenantId} { 
   allow read, write: if request.auth != null &amp;&amp; request.auth.token.tenantId == tenantId; 

   match /{allSubcollections=\*\*} { 
    allow read, write: if request.auth != null &amp;&amp; request.auth.token.tenantId == tenantId;
   }
  }
 }
}
