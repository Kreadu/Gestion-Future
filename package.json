{
  "name": "gestion-future",
  "version": "1.0.0",
  "description": "Sistema de gestión de nóminas Multi-tenant para outsourcing de RRHH",
  "main": "src/index.ts",
  "scripts": {
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
