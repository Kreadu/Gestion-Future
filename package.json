    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "playwright": "^1.56.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.3",
    "wrangler": "^3.22.0"
  }
}
